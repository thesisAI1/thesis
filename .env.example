# ─────────────────────────────────────────────────────────────
# THESIS — environment configuration
#
# Copy this file to `.env` and fill in keys WHEN you are ready to go live.
# With no keys and THESIS_MODE=mock, the whole system runs locally for $0.
# Load it by running the backend with:  node --env-file=.env ...
# ─────────────────────────────────────────────────────────────

# mock = no external calls, fake data, costs $0  (default)
# live = real APIs (requires the keys below)
THESIS_MODE=mock

# --- Frontrun API — X intelligence: CA history, smart followers ---
# Paid plan ~$200/mo · https://docs.frontrun.pro/paid-api-plan
FRONTRUN_API_KEY=
FRONTRUN_API_BASE=https://api.frontrun.pro

# --- X / Twitter API — mention monitoring + author timelines ---
X_BEARER_TOKEN=
# Numeric id of the agent's own X account (the account whose mentions we poll).
X_AGENT_USER_ID=
# OAuth 1.0a credentials — required for the agent to POST replies (buy /
# exit announcements and author payout requests). Generate these for the
# agent's own X account in the X developer portal.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# --- Base chain token data — free tiers available ---
BASEDATA_PROVIDER=dexscreener
BIRDEYE_API_KEY=

# --- Base chain RPC ---
# Sepolia testnet for development (free); mainnet for go-live.
BASE_RPC_URL=https://sepolia.base.org
BASE_CHAIN_ID=84532

# --- Trading wallet ---
# NEVER commit a real key. Use a throwaway testnet key during development.
TRADING_WALLET_PRIVATE_KEY=
# Safety gate. Real on-chain buys/sells fire ONLY when this is exactly "true".
# Leave blank until swaps have been validated on Base Sepolia.
LIVE_TRADING_ARMED=
# Swap routing (Base mainnet defaults).
BASE_WETH=0x4200000000000000000000000000000000000006
BASE_SWAP_ROUTER=0x2626664c2603336E57B271c5C0b26F421741e481
BASE_SWAP_FEE_TIER=10000
SWAP_SLIPPAGE_PCT=8
# $VIRTUAL (Virtuals Protocol) on Base. A graduated Virtuals agent token's pool
# is quoted in VIRTUAL — this both identifies it as a "virtuals" launchpad and
# is the hop the price reader converts VIRTUAL→ETH through. Default is mainnet.
BASE_VIRTUAL_TOKEN=0x0b3e328455c4059EEb9e3f84b5543F74E24e7E1b

# --- Solana support (ADDITIVE, OPTIONAL — leave blank for Base-only) ---
# THESIS trades Solana coins (pump.fun only) alongside Base. Swaps route through
# the Jupiter aggregator. The global LIVE_TRADING_ARMED gate above also guards
# real Solana swaps. Blank values keep Solana in mock mode.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# base58 secret key of the Solana trading wallet (separate from the EVM wallet).
SOLANA_TRADING_WALLET_KEY=
# A Solana win's 25% "buyback" slice goes here (no $THESIS on Solana to burn).
SOLANA_BUYBACK_WALLET=
JUPITER_API_BASE=https://quote-api.jup.ag/v6
SOLANA_SLIPPAGE_PCT=8
SOLANA_WSOL_MINT=So11111111111111111111111111111111111111112

# --- Treasury (the Endowment's 25/25/25/25 split) ---
# The launched $THESIS token — needed for buyback & burn. Blank until launch.
THESIS_TOKEN_ADDRESS=
# Team / maintenance wallet — receives 25% of each winning trade.
TEAM_WALLET=
# Where bought-back $THESIS is sent to be burned.
BURN_ADDRESS=0x000000000000000000000000000000000000dEaD

# --- 0x Swap API (DEX aggregator) ---
# Routes swaps through Uniswap v2/v3/v4, Aerodrome and 150+ DEXes automatically.
# Free key at https://dashboard.0x.org/. Required for live swaps.
ZEROEX_API_KEY=

# --- LLM — the Dean agent ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- HTTP server / website ---
PORT=4319
PUBLIC_BASE_URL=http://localhost:4319
# Shared secret for the /admin/* endpoints (force-close, settle payout, etc.).
# BLANK = admin endpoints fully DISABLED (503). Set to a long random string to
# enable them. The check is constant-time and locks out an IP after repeated
# wrong guesses, so use a high-entropy value (e.g. `openssl rand -hex 32`).
ADMIN_SECRET=
# Optional comma-separated IP allow-list for /admin/*. BLANK = no IP restriction
# (unchanged behaviour). Set to "127.0.0.1,::1" to make admin reachable only
# from localhost — drive it remotely via an SSH tunnel:
#   ssh -L 4319:localhost:4319 you@server   then hit http://localhost:4319/admin
ADMIN_ALLOWED_IPS=

# --- Database / persistence ---
# Which store the backend uses: "sqlite" (default, Prisma + SQLite) or "file"
# (the legacy JSON file store). Both are behaviour-identical.
THESIS_STORE=sqlite
# Where the store keeps its data (the SQLite db, or the JSON file). At runtime
# this is the single source of truth for the SQLite location.
DATA_DIR=./data
# Prisma CLI connection string. Used ONLY by the prisma CLI (generate / migrate);
# the running app derives its db path from DATA_DIR. Path is relative to the
# prisma/ schema dir, so this resolves to packages/backend/data/thesis.db —
# matching the default DATA_DIR=./data.
DATABASE_URL="file:../data/thesis.db"

# --- Service loops ---
POLL_INTERVAL_SEC=300
REVIEW_INTERVAL_SEC=20
MONITOR_INTERVAL_SEC=15

# --- Auditor (token gates) ---
MIN_TOKEN_AGE_HOURS=1
MAX_TOP10_PCT=30
# Market cap band (USD). Below the floor = too micro-cap / rug-prone;
# above the ceiling = already "discovered", limited upside.
MIN_MARKET_CAP_USD=40000
MAX_MARKET_CAP_USD=3000000
# BaseScan/Etherscan API key — for the Clanker launchpad deployer check (free tier).
BASESCAN_API_KEY=

# --- Triage (mention selection) ---
MIN_AUTHOR_FOLLOWERS=50
MIN_THESIS_WORDS=6
AUTHOR_COOLDOWN_HOURS=3
CONTRACT_DEDUP_HOURS=6
REVIEW_BUDGET_PER_HOUR=30
QUEUE_TTL_MIN=40

# --- Trading parameters ---
# The take-profit ladder (TP1 50%@+100%, TP2 25%@+200%, TP3 15%@+300%,
# TP4 10%@+1000%) is in code: config.trading.takeProfitTiers. The stop-loss
# trails 30% below the highest tier the position has reached.
POSITION_SIZE_MIN_PCT=5
POSITION_SIZE_MAX_PCT=10
STOP_LOSS_PCT=30
MAX_BUYS_PER_DAY=15
BUY_COOLDOWN_MINUTES=30

# --- Telegram bot (observability + admin commands) ---
# Leave blank to keep the bot disabled (TELEGRAM_ENABLED=false).
TELEGRAM_BOT_TOKEN=
# Set to "false" to disable the bot even if a token is present.
TELEGRAM_ENABLED=true
# Comma-separated list of Telegram chat IDs allowed to interact with the bot.
TELEGRAM_ALLOWED_CHATS=
# How often the bot polls Telegram for new updates (seconds).
TELEGRAM_POLL_INTERVAL_SEC=30

# --- Telegram public group notify bot (SEPARATE bot · broadcast-only) ---
# A second BotFather bot that broadcasts the trade lifecycle to the PUBLIC community
# group: buy executions, each take-profit tier, the merged profit-close 25/25/25/25
# split (with the author's @handle), and escrow author payouts. "Names-only" — never
# posts contract addresses, wallets, or tx hashes. Branded GIF + caption per event.
# Self-disables if the token or chat id is blank (so dev/mock runs stay silent).
#   1) Create a NEW bot via @BotFather and paste its token here.
#   2) Add that bot to the group, then put the group's chat id (a negative number) below.
TELEGRAM_GROUP_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
# Set to "false" to disable the group bot even if a token is present.
TELEGRAM_GROUP_ENABLED=true

# --- Observability ---
# Seconds of silence before the heartbeat watchdog fires a liveness:stale event.
# 0 = auto-derive: max(90, POLL_INTERVAL_SEC * 3).
HEARTBEAT_STALE_SEC=0
# Number of recent events kept in the in-memory event log ring buffer.
OBS_RECENT_BUFFER_SIZE=200
# Maximum rows retained in the durable Event table (Prisma sink). Oldest rows
# are pruned when the cap is exceeded. 50 000 ≈ weeks of operational headroom.
OBS_EVENT_LOG_CAP=50000
